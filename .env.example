# Example environment variables for MoviePass (gmoviepass)
# Copy to .env (and/or per-app .env files) and fill in real values locally.
# Do NOT commit real secrets.

# Application
APP_ENV=development
APP_DEBUG=false

# Backend (FastAPI)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=
SECRET_KEY=

# Frontend (booker)
VITE_API_BASE_URL=

# Frontend (owner)
VITE_OWNER_API_BASE_URL=
